{
  "name": "@ternaus/eslint-plugin-react",
  "version": "8.0.0-rc.2",
  "description": "React linting rules for ESLint 10 flat config",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0",
    "yarn": ">=4.17.1"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.mts",
        "default": "./index.js"
      },
      "default": "./index.js"
    },
    "./configs/recommended": {
      "import": {
        "types": "./configs/recommended.d.mts",
        "default": "./configs/recommended.js"
      },
      "require": {
        "types": "./configs/recommended.d.mts",
        "default": "./configs/recommended.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "types": "./index.d.mts",
  "files": [
    "CITATION.cff",
    "configs/",
    "configs/*.d.mts",
    "index.d.mts",
    "index.js",
    "lib/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "check:citation": "node scripts/check-citation.mjs",
    "check:html-metadata": "node scripts/check-html-attribute-metadata.mjs",
    "check:eslint-residual": "node scripts/check-eslint-residual.mjs",
    "check:biome-completeness": "node scripts/check-biome-completeness.mjs",
    "check:rule-documentation": "node scripts/check-rule-documentation.mjs",
    "docs:rules": "node scripts/update-rule-documentation.mjs",
    "generate:html-metadata": "node scripts/generate-html-attribute-metadata.mjs",
    "format": "biome check --write --linter-enabled=false .",
    "format:check": "biome check --linter-enabled=false .",
    "lint": "yarn check:biome-completeness && yarn lint:biome && yarn check:eslint-residual && yarn lint:eslint",
    "lint:biome": "biome lint . --error-on-warnings",
    "lint:eslint": "eslint .",
    "pack:check": "node scripts/pack-check.mjs",
    "prepack": "yarn quality:publish",
    "quality:complete": "yarn quality:publish && yarn pack:check && yarn test:package",
    "quality:publish": "yarn format:check && yarn check:citation && yarn check:html-metadata && yarn check:rule-documentation && yarn lint && yarn typecheck && yarn test:coverage",
    "test": "mocha --reporter min \"tests/lib/**/*.js\" tests/index.js tests/flat-config.js",
    "test:coverage": "c8 --all --extension .js --include index.js --include 'lib/**/*.js' --reporter text-summary --check-coverage --branches 90 --functions 95 --lines 95 --statements 95 mocha --reporter min \"tests/lib/**/*.js\" tests/index.js tests/flat-config.js",
    "test:package": "node scripts/test-package-consumer.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ternaus/eslint-plugin-react.git"
  },
  "bugs": {
    "url": "https://github.com/ternaus/eslint-plugin-react/issues"
  },
  "homepage": "https://github.com/ternaus/eslint-plugin-react#readme",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "react"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-eslint-plugin": "7.6.0",
    "eslint-plugin-n": "18.2.2",
    "globals": "^16.5.0",
    "html-validate": "9.7.1",
    "mocha": "^11.8.0",
    "publint": "^0.3.23",
    "sinon": "^21.0.0",
    "typescript": "5.9.3"
  }
}
