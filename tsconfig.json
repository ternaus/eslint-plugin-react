{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@ternaus/eslint-plugin-react": ["./index.d.mts"],
      "@ternaus/eslint-plugin-react/configs/all": ["./configs/all.d.mts"],
      "@ternaus/eslint-plugin-react/configs/jsx-runtime": ["./configs/jsx-runtime.d.mts"],
      "@ternaus/eslint-plugin-react/configs/recommended": ["./configs/recommended.d.mts"]
    },
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024"
  },
  "include": ["index.d.mts", "configs/*.d.mts", "tests/types/plugin.ts"]
}
